# ⚠️ 多租戶化之後，LINE 憑證的正本在 Firestore `workspaces/{id}`，**每個官方帳號各一組**。
#    這兩個只剩下面 seed-from-env 那支一次性工具在用（把第一組憑證寫進 workspaces/default）。
#    已經有工作區資料的環境不必設；設了也不會變成任何官方帳號的來源。
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# 排程／管理用密鑰（例如 POST /api/broadcast/trigger-scheduled、寫入 workspaces 的 seed）
CRON_SECRET=your_cron_secret
# 設為 false 可關閉伺服器內建「每分鐘檢查排程推播」（若改由 AWS EventBridge 呼叫 API）
# BROADCAST_CRON_ENABLED=true

# 對話訊息保留設定（搭配 POST /api/conversations/cleanup）
CONVERSATION_RETENTION_DAYS=180
CONVERSATION_CLEANUP_BATCH_SIZE=400

# 選填：活動未填 liffId 時，產生活動進入網址可 fallback 至此（亦可在後台「組織與 LINE」設定預設 LIFF）
# 該 LIFF 在 LINE Developers 的 Endpoint URL 須為 https://你的網域/liff/lead（與 Messaging API 的 /webhook 不同）
LIFF_DEFAULT_ID=

# 將 .env 的 LINE 憑證寫入 Firestore `workspaces/default`（一次性，之後可改 DB 不必改部署）
# curl -X POST "https://你的網域/api/admin/line-workspace/seed-from-env" -H "X-Cron-Secret: $CRON_SECRET"
# 對話清理（建議給 Cloud Scheduler 每天呼叫一次）
# curl -X POST "https://你的網域/api/conversations/cleanup" -H "X-Cron-Secret: $CRON_SECRET"
# 排程推播（建議每分鐘呼叫一次）
# curl -X POST "https://你的網域/api/broadcast/trigger-scheduled" -H "X-Cron-Secret: $CRON_SECRET"
# 付款到期對帳（建議每天呼叫一次；過期付費訂閱降免費、清卡住的 pending 訂單）
# curl -X POST "https://你的網域/api/payment/reconcile" -H "X-Cron-Secret: $CRON_SECRET"

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Firebase Client SDK (public)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# 對外 HTTPS 原點（無尾斜線）：金流 Notify/Return 導回、圖文 Imagemap、/api/r 點擊追蹤共用
PUBLIC_BASE_URL=https://your-domain

# ── PAYUNi 統一金流 整合式支付頁 UPP（目前使用中的金流；每租戶各一組特店；server-only）──
# 沙盒申請：https://sandbox.payuni.com.tw → 會員 › 商店清單 › 串接設定 取得三把金鑰。
# 三把都設好 → paymentEnabled 才會 true（build 時計算，設好要重新 build/部署）。
# PAYUNI_ENV=test 走 sandbox-api.payuni.com.tw、prod 走 api.payuni.com.tw。
# Hash Key 固定 32 碼、IV Key 固定 16 碼（長度不符後端會直接報錯）。
PAYUNI_MERCHANT_ID=your_payuni_mer_id
PAYUNI_HASH_KEY=your_payuni_hashkey_32_chars_xxxx
PAYUNI_HASH_IV=your_ivkey_16chr
PAYUNI_ENV=test

# 每月自動扣款（信用卡約定 Token 幕後扣款；見 docs/PAYUNI-RECURRING-DESIGN.md）。
# true = 首刷走 UPP 建立約定拿 CreditHash、之後每期由我方排程幕後扣款。
# ⚠️ 正式特店要先向 PAYUNi 申請開通「信用卡 Token／幕後扣款」並綁定授權 IP，否則會被擋。
#    留白／false → 完全走現行單次付款，一行行為都不變（灰度開關）。
# PAYUNI_PERIOD_ENABLED=true

# 固定出口 IP 中繼站（**只有正式環境需要**；見 docs/GOLIVE-BLOCKERS.md A3）。
# PAYUNi 幕後 API 會擋來源 IP（後台最多 10 組「單一」IP，不支援網段），而 Amplify 對外 IP
# 來自共用池且會變動（2026-08-04 實測一天換 4 個）→ 正式環境要把幕後呼叫收斂到一個固定出口。
# 值 = 中繼站的原點（無尾斜線、不含路徑）；中繼站把 /api/* 原樣轉發到對應環境的 PAYUNi 主機。
# ⚠️ 中繼站要與 PAYUNI_ENV 指向同一環境（正式對正式、測試對測試）。
# ⚠️ 客人刷卡的 UPP 付款頁**永遠直連 PAYUNi**，不經過中繼站 → 中繼站掛掉只會讓「本期自動
#    扣款延到隔天」，不影響客人付款。留白 = 直連 PAYUNi（現行行為）。
# PAYUNI_RELAY_BASE=https://relay.yourdomain.com

# ── 光貿（Amego）電子發票加值中心（**獨立於金流的商店帳號，需另外申請**）───────
# 三個值全設才會開票；未設 → 收款照常，訂單發票狀態記 skipped（不會擋付款）。
# ⚠️ 網址測試／正式都是 https://invoice-api.amego.tw（2026-08-14 實測）——**分辨測試或正式的是
#    「統編＋APP_KEY」這組帳號，不是網址**。所以換正式金鑰時兩個值要一起換：只換一個會變成
#    簽章對不起來（回 code 16），發票一張都開不出來。API_URL 仍刻意不給預設值，逼人有意識地填。
# ⚠️ 光貿後台「API 資訊 › 允許 IP」**留空**（＝不限制）。Amplify 對外 IP 每天在換，填了會變成
#    「收款成功但發票全部 skipped」的靜默故障（光貿回 code 14 IP 錯誤，後台看不出來）。
# ⚠️ 這三個也是前端 invoiceEnabled 的判斷來源（build 時計算，設好要重新 build/部署）。
GUANGMAO_INVOICE_SELLER_UBN=your_seller_ubn
GUANGMAO_INVOICE_APP_KEY=your_amego_app_key
GUANGMAO_INVOICE_API_URL=

# ── 交易通知信（AWS SES）：付款收據、扣款失敗、續扣提醒、額度用完 ──────────────
# 兩個都要設齊才會真的寄信；未設 → 寄信全變 no-op（只 log），金流／排程不受影響。
# EMAIL_FROM 必須是 SES 已驗證的網域／信箱，可帶顯示名稱。憑證由執行角色自動解析。
# EMAIL_FROM=MiniMe <noreply@your-domain>
# EMAIL_REPLY_TO=service@your-domain
# ⛔ 區域變數在 **Amplify 上不能叫 AWS_SES_REGION**（"AWS" 是保留前綴，整個被擋掉）。
#    程式的讀取順序是 AWS_SES_REGION → AWS_REGION，Amplify 執行環境本來就有 AWS_REGION，
#    所以線上「不設」才是對的；下面這行只給本機／非 Amplify 環境用。
# AWS_SES_REGION=ap-northeast-1

# ── 超管成本總覽：讀 AWS 帳單（選用）────────────────────────────────
# 設了才會在「成本總覽」頁顯示主機花費；沒設只是該區塊顯示「未接上」，不影響其他功能。
# 只需要 ce:GetCostAndUsage 一個唯讀權限。設定步驟見 docs/AWS-COST-SETUP.md
# ⛔ 名字**完全不能以 AWS 開頭**（不只是 AWS_ACCESS_KEY_ID 那兩個保留名）：Amplify 會擋掉
#    整個 "AWS" 前綴的自訂變數，Lambda 又會用執行角色蓋掉保留名 → 所以定名 COST_EXPLORER_*。
#    2026-08-14 修正：本檔原本寫 AWS_COST_*，那是程式從來沒讀過的名字，照著填不會有任何效果。
# COST_EXPLORER_ACCESS_KEY_ID=
# COST_EXPLORER_SECRET_ACCESS_KEY=

# ⛔ 藍新金流（NEWEBPAY_*）已於 2026-08-14 從本檔移除：金流一律走 PAYUNi，**不要再設**。
#    程式面的殘留（server/utils/newebpay.ts、routes/newebpay/*）由 STATUS.md `B-23` 負責清掉。
#    設了它會把 /newebpay/notify 這條舊路由重新變成「可開通訂閱」的入口 —— 那是風險不是相容性。

# Google AI Studio API key（Gemini answer + embedding 共用）。申請：https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# ── 對外品牌與營運主體（全部有預設值，本機不設也能跑）──────────────────────
# ⚠️ 這一組不是裝飾：**信用卡收單的風控會逐項核對**官網是否公開公司名稱、統編、客服信箱、
#    客服電話，以及「付款頁商品描述 / 電子發票品名 / 官網商品名稱」是否逐字一致。
#    改動前先確認與送審資料相同（見 nuxt.config.ts 的註解）。
# PUBLIC_BRAND_NAME=MiniMe                          # 產品名＝對外商標（≠ 公司名）
# PUBLIC_SERVICE_FULL_NAME=LINE MiniMe AI CRM 與客服系統   # 向金流申報的「商品名稱」
# PUBLIC_LEGAL_COMPANY_NAME=麥菲爾股份有限公司        # 發票賣方／法務頁主體
# PUBLIC_LEGAL_TAX_ID=83610942
# 信用卡帳單上的請款名稱 —— ⚠️ 與品牌名不同，要**逐字**照收單登記填（本平台是小寫 myfeel）。
# 不揭露它＝客人一個月後在帳單看到陌生名字會當成盜刷去爭議，而幕後扣款的爭議款我方自負。
# 會出現在：結帳確認框、收據信、商品資訊卡、服務條款、退費政策、頁尾。見 shared/billing/statement.ts
# PUBLIC_CARD_STATEMENT_NAME=myfeel
# PUBLIC_SUPPORT_EMAIL=service@your-domain
# PUBLIC_SUPPORT_PHONE=+886-2-7702-1310
# PUBLIC_SUPPORT_HOURS=週一至週五 10:00–18:00
# 選填：升級／加購對話框「聯繫我們」的 email 或 https 連結（未設則退回客服信箱）
# PUBLIC_SUPPORT_CONTACT=service@your-domain

# 選填：知識庫匯入對話框的「官方 FAQ 範本」母本試算表網址。
# 有設 → 顯示「建立副本」一鍵複製；未設或網址無法轉成 /copy → 退回下載 xlsx（功能不會壞）。
# ⚠️ 要填一般的 /spreadsheets/d/{檔案ID}/... 網址；「發布到網路」那種 /d/e/{發布ID}/ 不支援複製。
# PUBLIC_FAQ_TEMPLATE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/edit
